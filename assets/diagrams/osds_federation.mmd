%% @note 600 954 Conceptual relationships; not a claim that automated integrations already exist.
flowchart TB
    IRKB["IRKB — Interdisciplinary Research Knowledge Base<br/>Comparative synthesis and interdisciplinary research"]
    DRM["DRM · Shared entities · Provenance · Interoperability"]
    subgraph NEIGHBOURS[" "]
        direction TB
        subgraph ROW1[" "]
            direction LR
            EIRKB["EIRKB<br/>Ecological Information Research Knowledge Base"]
            EII["EII<br/>Ecological Indicators Inventory"]
            GISDS["GISDS<br/>GIS and Remote Sensing Database Sources"]
            EIRKB ~~~ EII ~~~ GISDS
        end
        subgraph ROW2[" "]
            direction LR
            SSKB["SSKB<br/>Systems Science and SES"]
            DPRKB["DPRKB<br/>Design Practice Research"]
            PBCKA["PBCKA"]
            SSKB ~~~ DPRKB ~~~ PBCKA
        end
        AMRKB["AMRKB<br/>Agricultural Modes Reference Knowledge Base"]
        ROW1 ~~~ ROW2 ~~~ AMRKB
    end
    subgraph OSDS["OSDS — Observational Systems and Data Sources<br/>Physical measurements and observation-system discovery"]
        direction TB
        subgraph OBS1[" "]
            direction LR
            C01["IoT and sensor telemetry"]
            C02["Scientific monitoring"]
            C01 ~~~ C02
        end
        subgraph OBS2[" "]
            direction LR
            C03["Ground-truth observations"]
            C04["Autonomous systems"]
            C03 ~~~ C04
        end
        subgraph OBS3[" "]
            direction LR
            C05["Field campaigns"]
            C06["Citizen sensing"]
            C05 ~~~ C06
        end
        subgraph OBS4[" "]
            direction LR
            C07["Physical computing"]
            C08["Historical records"]
            C07 ~~~ C08
        end
        OBS1 ~~~ OBS2 ~~~ OBS3 ~~~ OBS4
    end
    IRKB <--> DRM
    DRM <--> NEIGHBOURS
    NEIGHBOURS <--> OSDS
    classDef synthesis fill:#cce3f9,stroke:#173b6b,stroke-width:2px,color:#15243d;
    classDef shared fill:#e1daf0,stroke:#574087,stroke-width:2px,color:#29223e;
    classDef knowledgecard fill:#f0f7f2,stroke:#41744d,stroke-width:1.4px,color:#172b24;
    classDef sourcecard fill:#fef6e3,stroke:#a16a16,stroke-width:1.4px,color:#302b20;
    classDef neutral fill:#f8f9fa,stroke:#99a4b0,stroke-width:1.2px,color:#3a4656;
    classDef observation fill:#feeec9,stroke:#a16a16,stroke-width:2px,color:#543a13;
    classDef category fill:#fef6e3,stroke:#a16a16,stroke-width:1.4px,color:#302b20;
    class IRKB synthesis;
    class DRM shared;
    class EIRKB,SSKB,DPRKB,AMRKB knowledgecard;
    class EII,GISDS sourcecard;
    class PBCKA neutral;
    class OSDS observation;
    class C01,C02,C03,C04,C05,C06,C07,C08 category;
    style NEIGHBOURS fill:none,stroke:#d5dce4,stroke-dasharray:2 5
    style ROW1 fill:none,stroke:none
    style ROW2 fill:none,stroke:none
    style OBS1 fill:none,stroke:none
    style OBS2 fill:none,stroke:none
    style OBS3 fill:none,stroke:none
    style OBS4 fill:none,stroke:none
