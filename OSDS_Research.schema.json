        "properties": {
          "audit_alias": {
            "type": "string"
          },
          "source_id": {
            "type": "string"
          },
          "audit_name": {
            "type": "string"
          },
          "canonical_name": {
            "type": "string"
          },
          "origin_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
