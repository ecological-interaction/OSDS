              "null"
            ]
          },
          "predicate": {
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "type": [
              "string",
              "null"
            ]
          },
          "internal_targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
