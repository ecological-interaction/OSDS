              "properties": {
                "origin_id": {
                  "type": "string"
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "qualifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "existing_category_reference": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "states",
          "origin_ids",
          "content",
          "qualifications",
          "subject",
          "predicate",
          "object",
          "internal_targets"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OSDS:RA-[0-9]{4}$"
          },
          "label": {
            "type": "string"
