          "states": {
            "type": "object",
            "required": [
              "documentary_inclusion",
              "canonical_research_status",
              "identity_verification",
              "scientific_verification",
              "reported_authority",
              "authority_evidence",
              "relationship_review",
              "access",
              "rights"
            ],
            "properties": {
