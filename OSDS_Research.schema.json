          },
          "states": {
            "type": "object",
            "required": [
              "documentary_inclusion",
              "canonical_research_status",
              "identity_verification",
              "scientific_verification",
              "reported_authority",
              "authority_evidence",
              "relationship_review",
              "access",
              "rights"
            ],
            "properties": {
              "documentary_inclusion": {
                "const": "candidate_documentary"
              },
              "canonical_research_status": {
                "const": "candidate"
              },
              "identity_verification": {
                "const": "unverified"
              },
              "scientific_verification": {
                "const": "not_independently_verified"
              },
              "reported_authority": {
                "const": "audit_reported_or_author_analysis"
              },
              "authority_evidence": {
                "const": "original_scientific_turns_unavailable"
              },
              "relationship_review": {
                "const": "proposed"
              },
              "access": {
                "const": "not_assessed"
              },
              "rights": {
                "const": "unknown"
              }
            },
            "additionalProperties": false
          },
          "origin_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "origin_id",
                "fields",
                "text"
              ],
              "properties": {
                "origin_id": {
                  "type": "string"
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
