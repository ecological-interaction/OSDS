{
  "type": "object",
  "required": [
    "block_type",
    "schema",
    "document_version",
    "created",
    "status",
    "identifier_policy",
    "scientific_limits",
    "experimental_controls",
    "evidence_editions",
    "origins",
    "concepts",
    "assertions",
    "source_aliases",
    "counts"
  ],
  "properties": {
    "block_type": {
      "const": "documentary_research"
    },
    "schema": {
      "const": "osds.documentary-research/0.1.0"
    },
    "document_version": {
      "const": "0.2.0"
    },
    "created": {
      "const": "2026-11-03"
    },
    "status": {
      "const": "candidate_documentary_research"
    },
    "identifier_policy": {
      "type": "string"
    },
    "scientific_limits": {
      "type": "string"
    },
    "experimental_controls": {
      "type": "string"
    },
    "evidence_editions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "source_file",
          "sha256",
          "line_count",
          "authority",
          "rights",
          "access_limits"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "source_file": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "line_count": {
            "type": "integer",
            "minimum": 1
          },
          "authority": {
            "type": "string"
          },
          "rights": {
            "type": "string"
          },
          "access_limits": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "origins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "edition_id",
          "section",
          "subsection",
          "line_start",
          "line_end",
          "quote",
          "quote_sha256",
          "fields",
          "authority_context"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OSDS:OR-[0-9]{4}$"
          },
          "edition_id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "subsection": {
            "type": "string"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string"
          },
          "quote_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "authority_context": {
            "type": "object",
            "required": [
              "reported_role",
              "claim_basis",
              "source_claim",
              "authenticated",
              "original_message_locator"
            ],
            "properties": {
              "reported_role": {
                "enum": [
                  "audit_reported_user_decision",
                  "audit_reported_exchange",
                  "reconstruction_and_audit_analysis",
                  "audit_author_account"
                ]
              },
              "claim_basis": {
                "enum": [
                  "audit_field",
                  "audit_prose"
                ]
              },
              "source_claim": {
                "type": "string"
              },
              "authenticated": {
                "const": false
              },
              "original_message_locator": {
                "type": "null"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "typing_status",
          "states",
          "origin_ids",
          "content",
          "qualifications"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OSDS:RC-[0-9]{4}$"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "instrument_family_candidate",
              "observation_method_context",
              "theme_umbrella_candidate",
              "descriptive_dimension_candidate",
              "computing_platform_candidate",
              "standards_framework_candidate",
              "framework_reference_group",
              "technical_interface_group",
              "research_resource_candidate",
              "method_framework_candidate",
              "method_capability_candidate"
